        </mxCell>
        <mxCell id="164" value="Business and repository interfaces are in-process. External APIs and the database cross deployment boundaries. See README for flows and contracts." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=0;fontColor=#111111;spacing=0;" vertex="1" parent="1">
