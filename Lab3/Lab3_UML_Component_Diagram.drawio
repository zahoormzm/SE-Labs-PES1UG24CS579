        </mxCell>
        <mxCell id="163" value="Requests travel from the requiring socket to the providing ball; results return in the opposite direction." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontStyle=0;fontColor=#111111;spacing=0;" vertex="1" parent="1">
