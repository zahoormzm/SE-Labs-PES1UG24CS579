        <mxCell id="162" value="Solid ball-and-socket connections are UML assembly connectors." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=0;fontColor=#111111;spacing=0;" vertex="1" parent="1">
